# Copy this file to .env and fill in real values

APP_NAME=Shidori
ENVIRONMENT=development
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vidyarthi_yojna

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Auth — generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mobile number verification (OTP) for student registration.
# OTP_PROVIDER=console prints the code in the server log (development only).
# OTP_PROVIDER=twilio sends it by SMS: create a Verify Service in the Twilio console
# and copy the Account SID, Auth Token and Verify Service SID (starts with VA) here.
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Freeform SMS (e.g. "your account has been created"), sent with Twilio's regular
# Messaging API using the same Account SID / Auth Token above. Set TWILIO_FROM_NUMBER
# to the Twilio phone number to send from (E.164, e.g. +15551234567), or
# TWILIO_MESSAGING_SERVICE_SID if you use a Messaging Service instead of a single number.
# Leave both empty (or OTP_PROVIDER=console) to just log the message instead of sending it.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# First admin account, created on startup if no admin exists yet.
# Leave ADMIN_PASSWORD empty to skip. Change the password after first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@vidyarthiyojna.in
ADMIN_PASSWORD=

# Encryption key for Aadhaar / bank numbers and uploaded documents. KEEP IT SAFE —
# if it is lost, stored documents cannot be decrypted. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Uploaded documents
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Aadhaar reading. The QR code on the card is decoded locally (free, private).
# Only when that fails, the card image is sent to Claude to read DOB / taluka.
# Leave ANTHROPIC_API_KEY empty (or set AADHAAR_AI_FALLBACK=false) to never send cards to AI.
ANTHROPIC_API_KEY=
AADHAAR_AI_FALLBACK=true
AI_MODEL=claude-opus-5-5

# Online donations (Razorpay). Use test keys (rzp_test_...) until you go live.
# Webhook: Razorpay Dashboard → Webhooks → URL https://<your-site>/api/v1/donations/online/webhook,
# events payment.captured and order.paid; paste the secret you choose here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email for donation receipts (any SMTP mailbox). For Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=the address, and
# SMTP_PASSWORD=an App Password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
DONATION_RECEIPT_BCC=

# Where donors send donations — shown on the Donate page (leave empty to hide)
DONATION_UPI_ID=
DONATION_ACCOUNT_NAME=
DONATION_ACCOUNT_NUMBER=
DONATION_IFSC=
DONATION_BANK_NAME=
