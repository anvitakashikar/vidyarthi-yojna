# Copy this file to .env and fill in real values

APP_NAME=Vidyarthi Yojna
ENVIRONMENT=development
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vidyarthi_yojna

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Auth — generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin account, created on startup if no admin exists yet.
# Leave ADMIN_PASSWORD empty to skip. Change the password after first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@vidyarthiyojna.in
ADMIN_PASSWORD=

# Encryption key for Aadhaar / bank numbers and uploaded documents. KEEP IT SAFE —
# if it is lost, stored documents cannot be decrypted. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Uploaded documents
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Aadhaar reading. The QR code on the card is decoded locally (free, private).
# Only when that fails, the card image is sent to Claude to read DOB / taluka.
# Leave ANTHROPIC_API_KEY empty (or set AADHAAR_AI_FALLBACK=false) to never send cards to AI.
ANTHROPIC_API_KEY=
AADHAAR_AI_FALLBACK=true
AI_MODEL=claude-opus-5-5

# Where donors send donations — shown on the Donate page (leave empty to hide)
DONATION_UPI_ID=
DONATION_ACCOUNT_NAME=
DONATION_ACCOUNT_NUMBER=
DONATION_IFSC=
DONATION_BANK_NAME=
